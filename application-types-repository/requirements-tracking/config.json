    {
      "id": "explain-analysis-status",
      "type": "subagent",
      "icon": "HelpOutline",
      "labels": {
        "en": "Where does the analysis stand?",
        "de": "Wo steht die Analyse?",
        "it": "A che punto è l'analisi?",
        "zh": "分析进行到哪一步了？"
      },
      "payload": {
        "prompt": "Use the requirements-tracking MCP tools read-only to explain where the tender analysis stands: call rt_get_analysis_status and summarise the five stages (Dokumente einlesen, Anforderungen prüfen, Widersprüche klären, Abgleich mit Leistungskatalog, Management-Analyse), the readiness (how many requirement cards are still open, how many figure contradictions are unresolved, whether phase B is unlocked, whether the analysis is reliable or carries reservations), and what the human must do next. Use rt_list_proposals (kind extraction, status proposed) and rt_get_proposal to describe open cards with ambiguities or consistency alerts. You are reporting, not deciding: never approve, reject or resolve anything yourself — every decision is made by a human in the cockpit or the Review Queue."
      }
    },
    {
      "id": "explain-analysis-report",
      "type": "subagent",
      "icon": "Summarize",
      "labels": {
        "en": "Explain the management analysis",
        "de": "Erkläre die Management-Analyse",
        "it": "Spiega l'analisi per il management",
        "zh": "解释管理分析"
      },
      "payload": {
        "prompt": "Read the latest management analysis of this tender (rt_get_analysis_status returns state.report.markdownPath under out/analysis/; open that markdown file) and explain it to a manager in five sentences: the overall fulfilment assessment, the top risks (PARTIAL or NON_COMPLIANT verdicts on mandatory requirements, unmapped mandatory requirements), the vital clarifications for the customer, the internal open questions, and whether the analysis is reliable or carries reservations. Quote requirement ids. Use rt_get_requirement and rt_get_compliance_matrix for details. Do not change anything."
      }
    }
  ]
